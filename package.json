{
  "name": "agentic-spec",
  "version": "0.1.1",
  "description": "Give any design system a machine-readable, enforceable contract that AI agents read before they write code. Closed token lists, named parts, required states — validated in CI and served to agents over MCP.",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "agentic-spec": "dist/cli/index.js",
    "agentic-spec-mcp": "dist/mcp/index.js"
  },
  "files": ["dist", "_templates", "examples", "docs", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "test": "node --test --import tsx tests/*.test.ts",
    "benchmark": "npm run build && node benchmark/run.mjs",
    "validate:self": "tsx src/cli/index.ts validate examples"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "figma",
    "mcp",
    "agentic",
    "ai",
    "claude",
    "spec",
    "design-tokens-community-group"
  ],
  "author": "Tina Singh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tishsingh399/agentic-spec.git"
  },
  "homepage": "https://github.com/tishsingh399/agentic-spec",
  "bugs": "https://github.com/tishsingh399/agentic-spec/issues",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^12.1.0",
    "kleur": "^4.1.5",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
