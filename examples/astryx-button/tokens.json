    { "name": "color.overlay-hover",  "tier": "semantic", "role": "hover-overlay",             "path": "--color-overlay-hover",   "light": "#0536590C",           "status": "existing" },
    { "name": "color.overlay-pressed","tier": "semantic", "role": "active-overlay",            "path": "--color-overlay-pressed", "light": "#05365919",           "status": "existing" },
